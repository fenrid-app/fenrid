{
  "name": "fenrid-desktop",
  "version": "1.0.4",
  "private": true,
  "description": "Fenrid",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --config electron-builder.config.js --win nsis --x64 --publish never",
    "prepare:release": "node scripts/prepare-release.js"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "build": {
    "appId": "com.fenrid.desktop",
    "productName": "Fenrid",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/fenrid.ico",
      "artifactName": "Fenrid-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fenrid"
    }
  }
}
